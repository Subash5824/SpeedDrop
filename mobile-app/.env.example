# 24/7 Cloud Backend Production URL
EXPO_PUBLIC_BACKEND_URL=https://speeddrop.onrender.com

# Public Cloud Discovery Microservice (Zero-Configuration Auto-Discovery)
# Set this to your deployed Render, Railway, or Fly.io URL
# e.g., https://speeddrop.onrender.com
EXPO_PUBLIC_DISCOVERY_URL=https://speeddrop.onrender.com

BACKEND_URL=http://localhost:3000
BACKEND_PORT=3000

# App Configuration
APP_NAME=SpeedDrop
APP_VERSION=1.0.0

# Transfer Settings
CHUNK_SIZE=1048576
MAX_FILE_SIZE=10737418240
MAX_CONCURRENT_TRANSFERS=5

# Discovery Settings
DISCOVERY_TIMEOUT=5000
DISCOVERY_PORT=3000

# Storage Settings
STORAGE_DIR=./storage
CACHE_DIR=./cache

# Security
ENCRYPTION_ENABLED=false
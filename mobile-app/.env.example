# Backend / Tunnel Configuration (Localtunnel, Cloudflare, Ngrok, or Local IP)
# Examples:
# EXPO_PUBLIC_BACKEND_URL=https://your-subdomain.loca.lt
# EXPO_PUBLIC_BACKEND_URL=https://your-tunnel.trycloudflare.com
# EXPO_PUBLIC_BACKEND_URL=https://your-id.ngrok-free.app
# EXPO_PUBLIC_BACKEND_URL=http://192.168.1.5:3000
EXPO_PUBLIC_BACKEND_URL=

# Public Cloud Discovery Microservice (Zero-Configuration Auto-Discovery)
# Set this to your deployed Render, Railway, or Fly.io URL
# e.g., https://speeddrop-discovery.onrender.com
EXPO_PUBLIC_DISCOVERY_URL=https://speeddrop-discovery.onrender.com

BACKEND_URL=http://localhost:3000
BACKEND_PORT=3000

# App Configuration
APP_NAME=SpeedDrop
APP_VERSION=1.0.0

# Transfer Settings
CHUNK_SIZE=1048576
MAX_FILE_SIZE=10737418240
MAX_CONCURRENT_TRANSFERS=5

# Discovery Settings
DISCOVERY_TIMEOUT=5000
DISCOVERY_PORT=3000

# Storage Settings
STORAGE_DIR=./storage
CACHE_DIR=./cache

# Security
ENCRYPTION_ENABLED=false